---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { servicesConfig } from '@/config/site';

interface ServicesProps {
  class?: string;
}

const { class: className = '' } = Astro.props;

if (!servicesConfig.enabled || servicesConfig.items.length === 0) {
  // Return nothing if disabled
}
---

<section id="services" class="bg-white dark:bg-gray-950 {className}" aria-labelledby="services-heading">
  <div class="container">
    <header class="text-center mb-12 lg:mb-16">
      <h2 id="services-heading" class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {servicesConfig.title}
      </h2>
      {servicesConfig.subtitle && (
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          {servicesConfig.subtitle}
        </p>
      )}
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {servicesConfig.items.map((service, index) => (
        <Card key={index} variant="bordered" padding="lg" hover class="flex flex-col h-full">
          <div class="w-12 h-12 rounded-lg bg-primary-light dark:bg-primary/20 flex items-center justify-center mb-4" aria-hidden="true">
            {service.icon ? (
              <Icon name={service.icon} class="w-6 h-6 text-primary" />
            ) : (
              <Icon name="code" class="w-6 h-6 text-primary" />
            )}
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            {service.title}
          </h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed flex-1 mb-4">
            {service.description}
          </p>
          {service.link && (
            <Button variant="outline" size="sm" href={service.link.href} class="w-fit">
              {service.link.label}
              <Icon name="arrowRight" class="w-4 h-4 ml-1" aria-hidden="true" />
            </Button>
          )}
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
  :host { display: block; }
  .bg-white { background-color: var(--color-bg-primary); }
  .dark\:bg-gray-950 { background-color: var(--color-bg-primary); }
  .container { width: 100%; max-width: var(--container-xl); margin: 0 auto; padding: 0 var(--space-4); }
  @media (min-width: 640px) { .container { padding: 0 var(--space-6); } }
  @media (min-width: 1024px) { .container { padding: 0 var(--space-8); } }
  .text-center { text-align: center; }
  .mb-12 { margin-bottom: var(--space-12); }
  .lg\:mb-16 { margin-bottom: var(--space-16); }
  .text-3xl { font-size: var(--text-3xl); }
  .md\:text-4xl { font-size: var(--text-4xl); }
  .font-bold { font-weight: var(--font-bold); }
  .text-gray-900 { color: var(--color-gray-900); }
  .dark\:text-white { color: var(--color-white); }
  .mb-4 { margin-bottom: var(--space-4); }
  .text-lg { font-size: var(--text-lg); }
  .text-gray-600 { color: var(--color-gray-600); }
  .dark\:text-gray-300 { color: var(--color-gray-300); }
  .max-w-2xl { max-width: 42rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .grid { display: grid; }
  .grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
  .md\:grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
  .lg\:grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
  .gap-6 { gap: var(--space-6); }
  .lg\:gap-8 { gap: var(--space-8); }
  .flex { display: flex; }
  .flex-col { flex-direction: column; }
  .h-full { height: 100%; }
  .w-12 { width: 3rem; }
  .h-12 { height: 3rem; }
  .rounded-lg { border-radius: var(--radius-lg); }
  .bg-primary-light { background-color: var(--color-primary-light); }
  .dark\:bg-primary\/20 { background-color: color-mix(in srgb, var(--color-primary) 20%, transparent); }
  .items-center { align-items: center; }
  .justify-center { justify-content: center; }
  .mb-4 { margin-bottom: var(--space-4); }
  .w-6 { width: 1.5rem; }
  .h-6 { height: 1.5rem; }
  .text-primary { color: var(--color-primary); }
  .text-xl { font-size: var(--text-xl); }
  .font-semibold { font-weight: var(--font-semibold); }
  .text-gray-900 { color: var(--color-gray-900); }
  .dark\:text-white { color: var(--color-white); }
  .mb-2 { margin-bottom: var(--space-2); }
  .text-gray-600 { color: var(--color-gray-600); }
  .dark\:text-gray-300 { color: var(--color-gray-300); }
  .leading-relaxed { line-height: var(--leading-relaxed); }
  .flex-1 { flex: 1 1 auto; }
  .w-fit { width: fit-content; }
  .w-4 { width: 1rem; }
  .h-4 { height: 1rem; }
  .ml-1 { margin-left: 0.25rem; }

  @media (min-width: 768px) {
    .md\:grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .md\:text-4xl { font-size: var(--text-4xl); }
  }

  @media (min-width: 1024px) {
    .lg\:grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
    .lg\:mb-16 { margin-bottom: var(--space-16); }
    .lg\:gap-8 { gap: var(--space-8); }
  }
</style>