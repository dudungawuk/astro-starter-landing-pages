---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const publishedPosts = posts.filter((post) => !post.data.draft);
  const allTags = [...new Set(publishedPosts.flatMap((post) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.tags.map(t => t.toLowerCase()).includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const displayTag = tag.charAt(0).toUpperCase() + tag.slice(1);
const siteUrl = import.meta.env.SITE || 'https://example.com';
const tagUrl = new URL(`/blog/tags/${tag}/`, siteUrl).toString();
---

<BaseLayout
  title={`Tag: ${displayTag}`}
  description={`Articles tagged with "${displayTag}"`}
  url={tagUrl}
>
  <Header />

  <main id="main-content" class="flex-1" role="main">
    <section class="bg-gray-50 dark:bg-gray-900 py-16 lg:py-24" aria-labelledby="tag-heading">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <Badge variant="primary" class="mb-4 inline-block">
            {displayTag}
          </Badge>
          <h1 id="tag-heading" class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white mb-6">
            Articles tagged &ldquo;{displayTag}&rdquo;
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
            {posts.length} {posts.length === 1 ? 'article' : 'articles'} found.
          </p>
        </header>

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {posts.map((post) => (
              <Card variant="bordered" padding="none" hover class="overflow-hidden h-full flex flex-col" href={`/blog/${post.slug}/`}>
                {post.data.coverImage && (
                  <div class="relative aspect-video overflow-hidden" aria-hidden="true">
                    <img
                      src={post.data.coverImage}
                      alt=""
                      class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6 flex flex-col flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    {post.data.tags.slice(0, 2).map((t: string) => (
                      <Badge variant="default" size="sm">
                        {t}
                      </Badge>
                    ))}
                    {post.data.tags.length > 2 && (
                      <Badge variant="default" size="sm">
                        +{post.data.tags.length - 2} more
                      </Badge>
                    )}
                  </div>
                  <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 line-clamp-2">
                    {post.data.title}
                  </h2>
                  <p class="text-gray-600 dark:text-gray-300 leading-relaxed flex-1 mb-4 line-clamp-3">
                    {post.data.description}
                  </p>
                  <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 pt-4 border-t border-gray-100 dark:border-gray-800">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    {post.data.author && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{post.data.author}</span>
                      </>
                    )}
                  </div>
                </div>
              </Card>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <Icon name="tag" class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" aria-hidden="true" />
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">No articles found</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-6">No articles are tagged with &ldquo;{displayTag}&rdquo; yet.</p>
            <Button variant="primary" href="/blog/">Browse All Articles</Button>
          </div>
        )}

        <div class="mt-12 text-center">
          <Button variant="outline" href="/blog/">
            <Icon name="arrowLeft" class="w-4 h-4 mr-2" aria-hidden="true" />
            Back to All Articles
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  :host { display: block; }
  .bg-gray-50 { background-color: var(--color-bg-secondary); }
  .dark\:bg-gray-900 { background-color: var(--color-bg-secondary); }
  .py-16 { padding-top: var(--space-16); padding-bottom: var(--space-16); }
  .lg\:py-24 { padding-top: var(--space-24); padding-bottom: var(--space-24); }
  .container { width: 100%; max-width: var(--container-xl); margin: 0 auto; padding: 0 var(--space-4); }
  @media (min-width: 640px) { .container { padding: 0 var(--space-6); } }
  @media (min-width: 1024px) { .container { padding: 0 var(--space-8); } }
  .text-center { text-align: center; }
  .max-w-3xl { max-width: 48rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .mb-16 { margin-bottom: var(--space-16); }
  .mb-4 { margin-bottom: var(--space-4); }
  .inline-block { display: inline-block; }
  .text-3xl { font-size: var(--text-3xl); }
  .md\:text-4xl { font-size: var(--text-4xl); }
  .lg\:text-5xl { font-size: var(--text-5xl); }
  .font-extrabold { font-weight: var(--font-extrabold); }
  .text-gray-900 { color: var(--color-gray-900); }
  .dark\:text-white { color: var(--color-white); }
  .mb-6 { margin-bottom: var(--space-6); }
  .text-lg { font-size: var(--text-lg); }
  .md\:text-xl { font-size: var(--text-xl); }
  .text-gray-600 { color: var(--color-gray-600); }
  .dark\:text-gray-300 { color: var(--color-gray-300); }
  .leading-relaxed { line-height: var(--leading-relaxed); }
  .grid { display: grid; }
  .grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
  .md\:grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
  .lg\:grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
  .gap-6 { gap: var(--space-6); }
  .lg\:gap-8 { gap: var(--space-8); }
  .overflow-hidden { overflow: hidden; }
  .h-full { height: 100%; }
  .relative { position: relative; }
  .aspect-video { aspect-ratio: 16 / 9; }
  .w-full { width: 100%; }
  .h-full { height: 100%; }
  .object-cover { object-fit: cover; }
  .transition-transform { transition: transform var(--transition-normal); }
  .duration-500 { transition-duration: 500ms; }
  .hover\:scale-105:hover { transform: scale(1.05); }
  .p-6 { padding: var(--space-6); }
  .flex-col { flex-direction: column; }
  .flex-1 { flex: 1 1 auto; }
  .flex-wrap { flex-wrap: wrap; }
  .items-center { align-items: center; }
  .gap-2 { gap: var(--space-2); }
  .mb-3 { margin-bottom: var(--space-3); }
  .text-xl { font-size: var(--text-xl); }
  .font-semibold { font-weight: var(--font-semibold); }
  .text-gray-900 { color: var(--color-gray-900); }
  .dark\:text-white { color: var(--color-white); }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mb-2 { margin-bottom: var(--space-2); }
  .text-gray-600 { color: var(--color-gray-600); }
  .dark\:text-gray-300 { color: var(--color-gray-300); }
  .leading-relaxed { line-height: var(--leading-relaxed); }
  .mb-4 { margin-bottom: var(--space-4); }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pt-4 { padding-top: var(--space-4); }
  .border-t { border-top-width: 1px; }
  .border-gray-100 { border-color: var(--color-gray-100); }
  .dark\:border-gray-800 { border-color: var(--color-gray-800); }
  .gap-4 { gap: var(--space-4); }
  .text-sm { font-size: var(--text-sm); }
  .text-gray-500 { color: var(--color-gray-500); }
  .dark\:text-gray-400 { color: var(--color-gray-400); }
  .mt-12 { margin-top: var(--space-12); }
  .mr-2 { margin-right: var(--space-2); }
  .w-4 { width: 1rem; }
  .h-4 { height: 1rem; }
  .w-16 { width: 4rem; }
  .h-16 { height: 4rem; }
  .text-gray-300 { color: var(--color-gray-300); }
  .dark\:text-gray-600 { color: var(--color-gray-600); }
  .mb-4 { margin-bottom: var(--space-4); }
  .mb-2 { margin-bottom: var(--space-2); }
  .mb-6 { margin-bottom: var(--space-6); }

  @media (min-width: 768px) {
    .md\:grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .md\:text-4xl { font-size: var(--text-4xl); }
    .md\:text-xl { font-size: var(--text-xl); }
  }

  @media (min-width: 1024px) {
    .lg\:grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
    .lg\:gap-8 { gap: var(--space-8); }
    .lg\:py-24 { padding-top: var(--space-24); padding-bottom: var(--space-24); }
  }
</style>