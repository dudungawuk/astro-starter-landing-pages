# Site Configuration
# These are used for SEO, sitemap, and canonical URLs
SITE=https://your-domain.com
PUBLIC_SITE_NAME=Your Site Name

# Optional: Analytics
# PUBLIC_GA_ID=G-XXXXXXXXXX
# PUBLIC_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Forms/Contact
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
# NETLIFY_FORMS=true

# Optional: Search
# ALGOLIA_APP_ID=your-app-id
# ALGOLIA_API_KEY=your-api-key
# ALGOLIA_INDEX_NAME=your-index